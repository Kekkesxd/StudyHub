@model List<StudyHub.Models.Course>

@{
    ViewData["Title"] = "Current Courses";

    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Current Courses</h2>

            <p class="text-muted">
                Courses you are currently taking this semester.
            </p>

        </div>

        <a class="btn btn-primary"
           asp-action="Index">
            Browse Courses
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You do not have any current courses yet. Go to Courses and add some courses to your current semester.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var course in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow border-0 h-100">

                        <div class="card-body d-flex flex-column">

                            <h4>
                                @course.Title
                            </h4>

                            <span class="badge bg-primary mb-3">
                                @course.Code
                            </span>

                            <p class="text-muted">
                                @course.Description
                            </p>

                            <div class="mt-auto">

                                <a class="btn btn-outline-primary btn-sm"
                                   asp-action="Details"
                                   asp-route-id="@course.Id"
                                   asp-route-returnUrl="@returnUrl">
                                    Details
                                </a>

                                <a class="btn btn-danger btn-sm"
                                   asp-action="Unenroll"
                                   asp-route-id="@course.Id">
                                    Remove
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>