@model List<StudyHub.Models.Course>

@{
    ViewData["Title"] = "Courses";

    string returnUrl = Context.Request.Path + Context.Request.QueryString;

    List<int> currentCourseIds = ViewBag.CurrentCourseIds as List<int> ?? new List<int>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Courses</h2>

            <p class="text-muted">
                All courses and subjects you have created.
            </p>
        </div>

        <a class="btn btn-primary"
           asp-action="Create">
            Create Course
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <form method="get" class="row mb-4">

        <div class="col-md-5">
            <input type="text"
                   name="searchTerm"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Search courses..." />
        </div>

        <div class="col-md-3">

            <select name="sortOrder"
                    class="form-select">

                <option value="">
                    Sort by Title
                </option>

                <option value="title_desc">
                    Title Descending
                </option>

                <option value="code_asc">
                    Code Ascending
                </option>

                <option value="code_desc">
                    Code Descending
                </option>

            </select>

        </div>

        <div class="col-md-2">

            <button class="btn btn-primary w-100">
                Apply
            </button>

        </div>

    </form>

    <div class="row">

        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow h-100 border-0">

                    <div class="card-body d-flex flex-column">

                        <h4>@course.Title</h4>

                        <span class="badge bg-primary mb-3">
                            @course.Code
                        </span>

                        <p class="text-muted">
                            @course.Description
                        </p>

                        <p>
                            <strong>Instructor:</strong>
                            @course.Instructor
                        </p>

                        <div class="mt-auto">

                            <a class="btn btn-outline-primary btn-sm"
                               asp-action="Details"
                               asp-route-id="@course.Id"
                               asp-route-returnUrl="@returnUrl">
                                Details
                            </a>

                            @if (currentCourseIds.Contains(course.Id))
                            {
                                <a class="btn btn-danger btn-sm"
                                   asp-action="Unenroll"
                                   asp-route-id="@course.Id">
                                    Remove from Current
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-success btn-sm"
                                   asp-action="Enroll"
                                   asp-route-id="@course.Id">
                                    Add to Current
                                </a>
                            }

                            <a class="btn btn-warning btn-sm"
                               asp-action="Edit"
                               asp-route-id="@course.Id">
                                Edit
                            </a>

                            <a class="btn btn-danger btn-sm"
                               asp-action="Delete"
                               asp-route-id="@course.Id">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>